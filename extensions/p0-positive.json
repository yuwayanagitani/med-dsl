{
  "schema_version": "p2-extension-manifest-draft-1",
  "id": "p0-positive",
  "version": "draft-2",
  "title": "P0 の基底（採用・問い合わせ・比較）と核の不変条件",
  "status": {
    "review_state": "author_draft",
    "independent_review": false
  },
  "class": "BASE",
  "spec": {
    "path": "docs/research/06-p0-contract.md",
