          "path": [
            "certificate",
            "reason_codes"
          ],
          "equals": [
            "chain_obligation_failed"
          ],
          "kind": "refusal"
        },
        {
          "example": "examples/review/chain-forged-end-endpoint.json",
          "path": [
            "certificate",
            "reason_codes"
          ],
          "equals": [
            "chain_obligation_failed"
          ],
          "kind": "refusal"
        },
        {
          "example": "examples/review/chain-consistently-forged-policy.json",
          "path": [
            "certificate",
            "reason_codes"
          ],
          "equals": [
            "chain_obligation_failed"
          ],
          "kind": "refusal"
        },
        {
          "example": "examples/review/chain-consistently-forged-dependencies.json",
          "path": [
            "certificate",
            "reason_codes"
          ],
          "equals": [
            "chain_obligation_failed"
          ],
          "kind": "refusal"
        },
        {
          "example": "examples/review/chain-consistently-forged-scope.json",
          "path": [
            "certificate",
            "reason_codes"
          ],
          "equals": [
            "chain_obligation_failed"
          ],
          "kind": "refusal"
        }
      ]
