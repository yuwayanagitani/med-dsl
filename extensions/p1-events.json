{
  "schema_version": "p2-extension-manifest-draft-1",
  "id": "p1-events",
  "version": "draft-2",
  "title": "四項関係の事象化（役割付き事象への表現の改訂）",
  "status": {
    "review_state": "author_draft",
    "independent_review": false
  },
  "class": "R3",
  "spec": {
    "path": "src/med_dsl/events_spec.json",
    "sha256": "0fd014dd4904b2773839a8577675a59f7386ef2ea81ddb00c0def2ebbdf99cf3"
  },
  "contract_doc": "docs/research/13-p1-b-contract.md",
  "implementation": {
    "modules": [
      "src/med_dsl/events.py"
    ]
  },
  "pins": [
    {
      "path": "src/med_dsl/events_spec.json",
      "role": "native_spec"
    }
  ],
  "embedded_in": [
    "src/med_dsl/events.py",
    "src/med_dsl/handover_spec.json",
    "examples/p1-b/*.json",
    "examples/p1-c/*.json",
    "examples/review/*.json"
  ],
  "depends_on": [
    {
      "id": "p0-positive",
      "version": "draft-2"
    }
  ],
  "owns": {
    "operations": [
      "reify_events",
      "restore_events",
      "query_events",
      "compare_event_handover"
    ],
    "schema_versions": [
      "p1-events-request-draft-1",
      "p1-events-result-draft-1"
    ],
    "profiles": [
      "p1-events-draft-1"
    ],
    "answer_kinds": [
      "native_event_roles"
    ],
    "predicates": [
      "urn:med-dsl:events:active",
      "urn:med-dsl:events:role:"
    ],
    "capabilities": []
  },
  "scope": {
    "base_requests": "有限の四項肯定事実と正の結合 Q（宣言した部分）",
    "data": "選んだ一つの四項関係。新しい事象の件数・同一性を問う Q は範囲外",
    "guarantee": "native 経路は有限照合のみ。全モデルの認定は p1-event-chain"
  },
  "obligations": [
    {
      "id": "R3-1",
      "statement": "式の移し方 E（四役割を同じ事象に結ぶ）と回答の対応 ρ（旧変数への射影）を仕様に明示する",
      "evidence": "checked_native_template",
      "checks": [
        "tests/test_p1_events.py::test_projection_deduplicates_without_losing_duplicate_support",
        "tests/test_p1_events.py::test_all_subsets_of_eight_tuples_against_direct_relation_membership"
      ],
      "guards": [
        {
          "example": "examples/p1-b/split-witness.json",
          "path": [
            "comparison",
            "status"
          ],
          "equals": "mismatch",
          "kind": "refusal"
        }
      ]
    },
    {
      "id": "R3-2",
      "statement": "充足の対応：別の事象から役割を取る誤訳は、有限の反例として検出する",
      "evidence": "finite_check",
      "checks": [
        "tests/test_p1_events.py::test_split_witness_is_an_explicit_finite_countermodel",
        "tests/review/test_event_paths.py::SplitRolesTests.test_wrong_role_joins_are_found_and_the_result_is_never_certified"
      ],
      "guards": [
        {
          "example": "examples/p1-b/split-witness.json",
          "path": [
            "certificate",
            "reason_codes"
          ],
          "equals": [
            "satisfaction_condition_failed"
          ],
          "kind": "refusal"
        }
      ]
    },
    {
      "id": "R3-3",
      "statement": "旧モデルの被覆：旧モデルの四つ組を事象の集合＋予備要素へ持ち上げられる",
      "evidence": "hand_derivation",
      "checks": [
        "tests/test_p1_events.py::test_empty_relation_roundtrips_without_fabricated_spare_observation"
      ],
      "guards": [],
      "guard_gap": "被覆は手作業の導出（R5 C1-a）。反例の検査は参考意味（p1-reference）が担い、events 自身は有限照合だけ",
      "derivation": "docs/research/05-principles.md"
    },
    {
      "id": "R3-4",
      "statement": "新理論は翻訳した旧理論と型構造だけ。key の一意性・事象の一意名仮定を加えない",
      "evidence": "hand_derivation",
      "checks": [
        "tests/test_p1_events.py::test_same_key_and_same_tuple_have_distinct_internal_ids"
      ],
      "guards": [],
      "guard_gap": "構造の性質で、拒否する入力の例はない（件数・同一性の Q を範囲外にして検査している）",
      "derivation": "docs/research/16-proof-obligations.md"
    },
    {
      "id": "R3-5",
      "statement": "原履歴の完全な読み戻しと、採用・保留・訂正の可換",
      "evidence": "checked_native_template",
      "checks": [
        "tests/test_p1_events.py::test_reify_and_public_restore_preserve_complete_history",
        "tests/test_p1_events.py::test_history_change_is_not_hidden_by_equal_bindings"
      ],
      "guards": [
        {
          "example": "examples/p1-b/wrong-source-hash.json",
          "path": [
            "reason_codes"
          ],
          "equals": [
            "source_hash_mismatch"
          ],
          "kind": "refusal"
        },
        {
          "example": "examples/p1-b/wrong-source-assertion.json",
          "path": [
            "reason_codes"
          ],
          "equals": [
            "source_assertion_mismatch"
          ],
          "kind": "refusal"
        }
      ]
    },
    {
      "id": "R3-6",
      "statement": "事象 ID は原台帳・主張に対して新鮮で、既存の名前・互いと衝突しない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/test_p1_events.py::test_generated_reference_collision_is_detected",
        "tests/test_p1_events.py::test_selected_relation_cannot_remain_as_old_atom_or_collide_with_native_predicate"
      ],
      "guards": [
        {
          "example": "examples/p1-b/existing-name-collision.json",
          "path": [
            "reason_codes"
          ],
          "equals": [
            "event_reference_collision"
          ],
          "kind": "refusal"
        },
        {
          "example": "examples/p1-b/duplicate-event-id.json",
          "path": [
            "reason_codes"
          ],
          "equals": [
            "event_reference_collision"
          ],
          "kind": "refusal"
        }
      ]
    },
    {
      "id": "R3-7",
      "statement": "事象の件数・同一性・未知の式は範囲外と明示し、保証に含めない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/test_p1_events.py::test_event_count_identity_and_unknown_expressions_are_out_of_scope"
      ],
      "guards": [
        {
          "example": "examples/p1-b/out-of-scope.json",
          "path": [
            "comparison",
            "status"
          ],
          "equals": "partial",
          "kind": "refusal"
        }
      ]
    },
    {
      "id": "K-ID",
      "statement": "仕様・consumer・snapshot の hash を実体と照合し、原 snapshot の hash を固定する",
      "evidence": "checked_native_template",
      "checks": [
        "tests/test_p1_events.py::test_native_spec_and_consumer_cannot_be_spoofed"
      ],
      "guards": [
        {
          "example": "examples/p1-b/wrong-source-hash.json",
          "path": [
            "status"
          ],
          "equals": "invalid_input",
          "kind": "refusal"
        }
      ]
    },
    {
      "id": "K-STOP",
      "statement": "未知の能力・衝突は比較不能（unassessed）。部分の結果を完全にしない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/test_p1_events.py::test_pending_revision_conflict_contexts_and_unknown_caps_keep_p0_selection"
      ],
      "guards": [
        {
          "example": "examples/p1-b/unknown-capability.json",
          "path": [
            "comparison",
            "status"
          ],
          "equals": "unassessed",
          "kind": "refusal"
        },
        {
          "example": "examples/p1-b/conflict.json",
          "path": [
            "comparison",
            "status"
          ],
          "equals": "unassessed",
          "kind": "refusal"
        }
      ]
    },
    {
      "id": "K-INV",
      "statement": "I1 支持は採用された主張から／I3 AI 候補を採用しない／I4 未知の能力で停止／I6 原履歴を保持",
      "evidence": "checked_native_template",
      "checks": [
        "tests/test_p1_events.py::test_returned_artifact_and_restored_source_do_not_alias_inputs"
      ],
      "guards": [
        {
          "example": "examples/p1-b/ai-unreviewed.json",
          "path": [
            "certificate",
            "status"
          ],
          "equals": "not_certified",
          "kind": "non_conversion"
        },
        {
          "example": "examples/p1-b/unknown-capability.json",
          "path": [
            "target_result",
            "results",
            0,
            "status"
          ],
          "equals": "unassessed",
          "kind": "refusal"
        }
      ]
    },
    {
      "id": "K-RES",
      "statement": "生成・復元・問い合わせ・比較を共通予算に課金し、中間・返却 binding の上限で止まる",
      "evidence": "checked_native_template",
      "checks": [
        "tests/test_p1_events.py::test_reify_restore_never_publish_partial_history",
        "tests/review/test_boundaries.py::EventLimitTests.test_intermediate_binding_limit_is_exactly_4096"
      ],
      "guards": [],
      "guard_gap": "上限の境界は例ではなくテスト（境界値の構成が大きいため）で検査している"
    }
  ],
  "stops": {
    "unknown_capability": "基底の方針に従い、可視の主張の未知の能力は文脈を unassessed",
    "unsupported": "未対応の操作・consumer は unsupported_profile",
    "resource": "resource_limit。部分の履歴・binding・差分・認定票を出さない",
    "invalid_input": "役割の欠落・複数・ID 衝突・由来・hash の不正は invalid_input"
  },
  "composition": {
    "shares_names_with": [],
    "reads_extensions": [],
    "order_dependent": false
  },
  "evaluation": {
    "examples": [
      "examples/p1-b/*.json"
    ],
    "tests": [
      "tests/test_p1_events.py",
      "tests/review/test_event_paths.py"
    ],
    "budget_sweep": true,
    "oracle": "tests/review/reference_oracle.py"
  }
}
