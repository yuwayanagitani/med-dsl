{
  "schema_version": "p2-extension-manifest-draft-1",
  "id": "p2-quantity-literal",
  "version": "draft-1",
  "title": "量リテラルの厳密換算と有限区間比較",
  "status": {
    "review_state": "author_draft",
    "independent_review": false
  },
  "class": "R2",
  "spec": {
    "path": "src/med_dsl/quantity_spec.json",
    "sha256": "84af2e771d1868471d0a8441021fde2a7253b1fc17f8ff9b807461e3df7f1f43"
  },
  "contract_doc": "docs/research/34-p2-f-design.md",
  "implementation": {
    "modules": [
      "src/med_dsl/quantity.py"
    ]
  },
  "pins": [
    {
      "path": "src/med_dsl/host.py",
      "role": "dispatcher"
    },
    {
      "path": "docs/research/35-p2-f-cases.md",
      "role": "hand_specified_expectations"
    }
  ],
  "embedded_in": [
    "examples/p2-quantity/*.json"
  ],
  "depends_on": [
    {
      "id": "p0-positive",
      "version": "draft-2"
    }
  ],
  "owns": {
    "operations": [
      "evaluate_quantities"
    ],
    "schema_versions": [
      "p2-quantity-request-draft-1",
      "p2-quantity-result-draft-1"
    ],
    "profiles": [
      "p2-quantity-literal-draft-1"
    ],
    "answer_kinds": [
      "quantity_literal_result"
    ],
    "predicates": [],
    "capabilities": [
      "p2-quantity-literal-draft-1"
    ]
  },
  "scope": {
    "base_requests": "旧要求は旧経路に保持。量の値・区間関係を基底の支持へ変換しない",
    "fragment": "架空の固定7単位・5量種。正の倍率、有理数、有限非空区間。臨床状態の読み書きなし。R2-3は基底を読まない範囲で空虚に満たす"
  },
  "obligations": [
    {
      "id": "K-ID",
      "statement": "仕様hash、profile、操作を固定して照合する",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_native_identity_and_integer_bounds"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/n10-hash.json",
          "path": [
            "status"
          ],
          "equals": "unsupported_profile",
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "K-STOP",
      "statement": "未知能力・未知単位・未知量種、不正と未対応を区別する",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_unknowns_priority_unused_literals_and_same_reference"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q21.json",
          "path": [
            "results",
            0,
            "reason_codes"
          ],
          "equals": [
            "unknown_unit"
          ],
          "kind": "boundary"
        },
        {
          "example": "examples/p2-quantity/q23.json",
          "path": [
            "results",
            0,
            "reason_codes"
          ],
          "equals": [
            "unknown_capability"
          ],
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "K-INV",
      "statement": "入力・出自・未評価の不確かさを保ち、臨床情報を補わない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_input_immutability_array_permutation_and_origin_retention"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q24.json",
          "path": [
            "clinical_confirmation"
          ],
          "equals": "not_evaluated",
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "K-RES",
      "statement": "共有予算の途中では値と完成根拠を出さない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_budget_sweep_atomic_rows_and_exact_costs"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/b01.json",
          "path": [
            "steps_used"
          ],
          "equals": 0,
          "kind": "boundary"
        },
        {
          "example": "examples/p2-quantity/b04-8.json",
          "path": [
            "results",
            1,
            "calculation_evidence"
          ],
          "equals": null,
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "R2-1",
      "statement": "基底に書かず、原情報を変更しない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_input_immutability_array_permutation_and_origin_retention"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q24.json",
          "path": [
            "clinical_assertions_added"
          ],
          "equals": [],
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "R2-2",
      "statement": "計算の結論を基底の状態として返さない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_no_clinical_or_base_promotion_and_no_base_reads"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q09.json",
          "path": [
            "converted_to_base"
          ],
          "equals": false,
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "R2-3",
      "statement": "基底を全く読まない断片であり、採用選択を迂回した読みもない。この断片を超えた保証はしない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_no_clinical_or_base_promotion_and_no_base_reads"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q24.json",
          "path": [
            "results",
            0,
            "status"
          ],
          "equals": "computed",
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "R2-4",
      "statement": "回答型を分離し、数値の一致を医学的同一性にしない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_no_clinical_or_base_promotion_and_no_base_reads"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q09.json",
          "path": [
            "meaning_mode"
          ],
          "equals": "quantity_literal_result",
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "R2-5",
      "statement": "理解できる能力を固定し、自己申告と外部単位表を採用しない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_hand_expectations_api_cli_and_manifest"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/n07-units.json",
          "path": [
            "status"
          ],
          "equals": "invalid_input",
          "kind": "boundary"
        },
        {
          "example": "examples/p2-quantity/q23.json",
          "path": [
            "results",
            0,
            "converted_domain"
          ],
          "equals": null,
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "QT-1",
      "statement": "局所名の範囲を仕様に固定し大小文字を補完しない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_unknowns_priority_unused_literals_and_same_reference"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q21.json",
          "path": [
            "results",
            0,
            "certain_relation"
          ],
          "equals": null,
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "QT-2",
      "statement": "負数・未約分の入力を保持し、浮動小数点化せず計算する",
      "evidence": "finite_check",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_exact_conversion_and_roundtrip_for_each_compatible_unit"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q06.json",
          "path": [
            "results",
            0,
            "converted_domain"
          ],
          "equals": {
            "lower": {
              "numerator": -3,
              "denominator": 2
            },
            "upper": {
              "numerator": -3,
              "denominator": 2
            },
            "lower_closed": true,
            "upper_closed": true
          },
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "QT-3",
      "statement": "正の倍率の換算は境界の開閉を保存し、入力範囲内の往復は厳密",
      "evidence": "finite_check",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_exact_conversion_and_roundtrip_for_each_compatible_unit"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q07.json",
          "path": [
            "results",
            0,
            "converted_domain",
            "lower_closed"
          ],
          "equals": false,
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "QT-4",
      "statement": "区間は代表値へ潰さず、同一参照だけ一変数とする",
      "evidence": "finite_check",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_finite_domain_relations_against_witness_points"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q15.json",
          "path": [
            "results",
            0,
            "relation_set"
          ],
          "equals": [
            "less",
            "equal",
            "greater"
          ],
          "kind": "boundary"
        },
        {
          "example": "examples/p2-quantity/q16.json",
          "path": [
            "results",
            0,
            "relation_set"
          ],
          "equals": [
            "equal"
          ],
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "QT-5",
      "statement": "次元と量種の不一致を比較不能として別々に返す",
      "evidence": "finite_check",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_hand_expectations_api_cli_and_manifest"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q18.json",
          "path": [
            "results",
            0,
            "reason_codes"
          ],
          "equals": [
            "incompatible_quantity_kind"
          ],
          "kind": "boundary"
        },
        {
          "example": "examples/p2-quantity/q19.json",
          "path": [
            "results",
            0,
            "reason_codes"
          ],
          "equals": [
            "incompatible_dimension"
          ],
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "QT-6",
      "statement": "統計的不確かさ・丸め・臨床採用を未実装として区別する",
      "evidence": "finite_check",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_hand_expectations_api_cli_and_manifest"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/n09-uncertainty.json",
          "path": [
            "status"
          ],
          "equals": "unsupported_profile",
          "kind": "boundary"
        },
        {
          "example": "examples/p2-quantity/q24.json",
          "path": [
            "uncertainty_propagated"
          ],
          "equals": false,
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "QT-7",
      "statement": "未知・静的上限・打切りで完成値を漏らさない",
      "evidence": "finite_check",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_structural_refusals_precede_budget"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/n02-n.json",
          "path": [
            "reason_codes"
          ],
          "equals": [
            "rational_integer_limit"
          ],
          "kind": "boundary"
        },
        {
          "example": "examples/p2-quantity/b02-7.json",
          "path": [
            "results",
            0,
            "converted_domain"
          ],
          "equals": null,
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "QT-8",
      "statement": "旧経路の非干渉、決定性と意味の変異の検出を検査する",
      "evidence": "finite_check",
      "checks": [
        "tests/p2/test_quantity.py::QuantityTests.test_each_targeted_semantic_mutant_is_detected"
      ],
      "guards": [
        {
          "example": "examples/p2-quantity/q24.json",
          "path": [
            "certificate",
            "status"
          ],
          "equals": "not_certified",
          "kind": "boundary"
        }
      ]
    }
  ],
  "stops": {
    "unknown_capability": "参照する量の未知能力を最優先してunassessed",
    "unsupported": "unsupported_profile。未知の演算種・不確かさ・量表現・消費側仕様",
    "resource": "resource_limit。63bit入力上限・256bit中間上限・共有steps。未完了行はnull",
    "invalid_input": "構造・参照・分母・区間・既知入力の次元矛盾を予算の前に検証"
  },
  "composition": {
    "shares_names_with": [],
    "reads_extensions": [],
    "order_dependent": false
  },
  "evaluation": {
    "examples": [
      "examples/p2-quantity/*.json"
    ],
    "tests": [
      "tests/p2/test_quantity.py"
    ],
    "budget_sweep": true,
    "oracle": "tests/p2/quantity_oracle.py"
  }
}
