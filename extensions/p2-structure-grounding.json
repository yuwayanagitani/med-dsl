  "scope": {
    "base_requests": "旧要求とP2-o・P2-i・P2-fを変えず、P2-oを固定版で一度だけ実行し、満たされたexchangeの行にだけ構造への写像の可否を判定する",
    "fragment": "構造 fhir-r5-observation の一つだけ。値（quantity・range）、期間の端の規約、文脈（method・specimen）の運び方、運べないもの。status・code・Provenance・Quantityのcomparator・コード化した単位は範囲外。FHIRへの適合は主張しない"
  },
  "obligations": [
    {
      "id": "K-ID",
      "statement": "自己・P2-oの版と実体を固定し、旧profileや他拡張の結果を代用しない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_grounding.py::GroundingTests.test_static_validation_pins_limits_and_native_refusals"
      ],
      "guards": [
        {
          "example": "examples/p2-grounding/n02-profile_spec_sha256.json",
          "path": [
            "status"
          ],
          "equals": "unsupported_profile",
          "kind": "refusal"
        }
      ]
    },
    {
      "id": "K-STOP",
      "statement": "P2-oの停止（能力・選択・要素）を先に通し、構造の判定は満たされた行だけに行う",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_grounding.py::GroundingTests.test_other_rows_pass_through_and_representable_rows_keep_the_library_columns"
      ],
      "guards": [
        {
          "example": "examples/p2-grounding/r03.json",
          "path": [
            "results",
            0,
            "reason_codes"
          ],
          "equals": [
            "unknown_capability"
          ],
          "kind": "boundary"
        }
      ]
    },
    {
      "id": "K-INV",
      "statement": "推測で補った情報を作らず、入力を変更せず、臨床の主張を追加しない",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_grounding.py::GroundingTests.test_nothing_is_rounded_closed_or_added"
      ],
      "guards": [
        {
          "example": "examples/p2-grounding/g01.json",
          "path": [
            "inferred_information"
          ],
          "equals": [],
          "kind": "non_conversion"
        }
