          "equals": "unsupported_profile",
          "kind": "refusal"
        }
      ]
    },
    {
      "id": "K-STOP",
      "statement": "比較範囲の外の参照は比較せず（not_compared）、新版にない参照は後継を決めない（not_found）",
      "evidence": "checked_native_template",
      "checks": [
        "tests/p2/test_audit.py::AuditTests.test_continuation_is_by_source_and_id_never_by_name"
