      "checks": [
        "tests/p2/test_audit.py::AuditTests.test_static_validation_pins_limits_and_native_refusals"
      ],
      "guards": [
        {
          "example": "examples/p2-audit/n02-profile_spec_sha256.json",
          "path": [
